{
  "name": "pi-qser3ne-patch",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Qser3ne/pi-qser3ne-patch.git"
  },
  "description": "Unified Pi extension for Codex accounts, Fast mode, Daybreak Blue, subscription quotas, token speed and today statusline usage.",
  "type": "module",
  "private": true,
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "sub2api",
    "usage",
    "quota",
    "statusline"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --experimental-strip-types --test test/*.test.ts tests/daybreak.test.mjs",
    "test:integration": "node --experimental-strip-types --test tests/daybreak.integration.test.mjs",
    "typecheck": "tsc --noEmit",
    "vendor:pi-usage": "node scripts/vendor-pi-usage.mjs",
    "vendor:pi-statusline": "node scripts/vendor-pi-statusline.mjs",
    "vendor:token-usage": "node scripts/vendor-token-usage.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@narumitw/pi-statusline": "0.50.2",
    "@narumitw/pi-usage": "0.69.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "jiti": "2.7.0",
    "ws": "8.22.1"
  },
  "dependencies": {
    "@narumitw/pi-tui-kit": "0.68.0",
    "undici": "^7.30.1"
  }
}
